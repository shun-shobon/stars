{
	"extends": ["@tsconfig/strictest/tsconfig.json"],
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"noEmit": true,
		"exactOptionalPropertyTypes": false,
		"verbatimModuleSyntax": true,
		"types": ["./worker-configuration.d.ts"]
	},
	"include": ["src/worker.ts"]
}
