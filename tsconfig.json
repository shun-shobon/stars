{
	"extends": ["@tsconfig/vite-react/tsconfig.json", "@tsconfig/strictest/tsconfig.json"],
	"compilerOptions": {
		"noEmit": true,
		"exactOptionalPropertyTypes": false,
		"verbatimModuleSyntax": true,
		"types": ["vite/client", "@webgpu/types"],
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["src"],
	"exclude": ["src/worker.ts"]
}
