{
	"name": "stars",
	"version": "0.1.0",
	"private": true,
	"description": "WebGPUを使用した星空レンダリングWebアプリケーション。東京からの星空をリアルタイムで表示します。",
	"license": "MIT",
	"author": "NISHIZAWA Shuntaro <me@s2n.tech> (https://s2n.tech/)",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"gen:catalog": "node scripts/generate-catalog.ts && oxfmt src/catalog/catalog-meta.json",
		"gen:milky-way": "node scripts/generate-milky-way.ts",
		"knip": "knip",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src && tsc --noEmit -p worker",
		"typegen": "wrangler types worker/worker-configuration.d.ts"
	},
	"dependencies": {
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.70.1",
		"@shun-shobon/oxfmt-config": "7.1.2",
		"@shun-shobon/oxlint-config": "7.1.2",
		"@tailwindcss/vite": "4.3.5",
		"@tsconfig/node-lts": "26.0.1",
		"@tsconfig/strictest": "2.0.9",
		"@tsconfig/vite-react": "8.1.2",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"@webgpu/types": "0.1.74",
		"knip": "6.48.0",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"oxlint-tsgolint": "7.0.2008",
		"sharp": "0.35.5",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.1",
		"wrangler": "4.166.0"
	},
	"packageManager": "pnpm@12.23.0"
}
